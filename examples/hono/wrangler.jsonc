{
    // victoria-orm Cloudflare Workers example
    "name": "victoria-orm-example-hono",
    "compatibility_date": "2025-01-01",
    "main": "src/index.ts",
    // Environment variables
    "vars": {
        "VICTORIA_BASE_URL": "http://localhost:9428",
        "VICTORIA_TOKEN": ""
    },
    // D1 database binding
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "emails-db",
            "database_id": "local"
        }
    ],
    // Cron triggers — archive D1 emails to VictoriaLogs
    "triggers": {
        "crons": [
            "10 23 * * *",
            "*/1 * * * *"
        ]
    }
}