{
  "name": "victoria-orm-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/victoria-orm",
    "test": "npm run test --workspace=packages/victoria-orm",
    "dev:nextjs": "npm run dev --workspace=examples/nextjs",
    "dev:hono": "npm run dev --workspace=examples/hono",
    "seed": "node scripts/seed.mjs",
    "seed:large": "node scripts/seed.mjs --count=500",
    "seed:emails": "node scripts/seed-emails.mjs --count=1000000",
    "seed:emails:small": "node scripts/seed-emails.mjs --count=10000"
  }
}